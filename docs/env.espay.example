# ===== Espay =====
# Kredensial paling mudah diisi lewat Admin Panel > Payment Channels > Espay (disimpan di DB, private key terenkripsi).
# Nilai di .env hanya dipakai bila field di Admin Panel kosong. Mode di Admin Panel juga mengalahkan ESPAY_IS_PRODUCTION.
ESPAY_IS_PRODUCTION=true

# --- Production (diisi dari data Espay) ---
ESPAY_PRODUCTION_MERCHANT_CODE=
ESPAY_PRODUCTION_API_KEY=
ESPAY_PRODUCTION_SIGNATURE_KEY=
ESPAY_PRODUCTION_PASSWORD=
ESPAY_PRODUCTION_DISB_PARTNER_ID=
ESPAY_PRODUCTION_DISB_SOURCE_ACCOUNT=
ESPAY_PRODUCTION_DISB_SOURCE_BANK_CODE=
# Path file PEM relatif ke root aplikasi (jangan di-commit)
ESPAY_PRODUCTION_PRIVATE_KEY=storage/app/espay/production/private.pem
ESPAY_PRODUCTION_ESPAY_PUBLIC_KEY=storage/app/espay/production/espay_public.pem

# Host production (konfirmasi ke Espay; nilai di bawah adalah default di config/espay.php)
# ESPAY_PRODUCTION_API_URL=https://api-merchant.espay.id
# ESPAY_PRODUCTION_MERCHANT_INFO_URL=https://api.espay.id/rest/merchant/merchantinfo
# ESPAY_PRODUCTION_SEND_INVOICE_URL=https://api-merchant.espay.id/rest/merchantpg/sendinvoice
# ESPAY_PRODUCTION_CHECK_STATUS_URL=https://api.espay.id/rest/merchant/status

# --- Sandbox (untuk server staging) ---
ESPAY_SANDBOX_MERCHANT_CODE=
ESPAY_SANDBOX_API_KEY=
ESPAY_SANDBOX_SIGNATURE_KEY=
ESPAY_SANDBOX_PASSWORD=
ESPAY_SANDBOX_PRIVATE_KEY=storage/app/espay/sandbox/private.pem
ESPAY_SANDBOX_ESPAY_PUBLIC_KEY=storage/app/espay/sandbox/espay_public.pem

# --- Umum ---
ESPAY_PAYMENT_ID_PREFIX=EDU
ESPAY_EXPIRY_MINUTES=1440
ESPAY_MINIMUM_AMOUNT=10000

# --- Disbursement ---
# Sumber dana model Deposit: PTPLUS + kode bank sumber dari Espay (sandbox: 022)
# ESPAY_DISB_DEFAULT_SOURCE_ACCOUNT=PTPLUS
# ESPAY_DISB_DEFAULT_SOURCE_BANK_CODE=022
# ESPAY_DISB_FEE_TYPE=OUR
# ESPAY_DISB_MINIMUM_AMOUNT=10000
# ESPAY_DISB_MAXIMUM_AMOUNT=250000000
# Deposit Espay harus >= nominal + cadangan ini, bila kurang payout ditahan (biaya BI-FAST sandbox Rp2.500)
# ESPAY_DISB_DEPOSIT_FEE_BUFFER=5000
# ESPAY_DISB_STATUS_CHECK_MINUTES=15
